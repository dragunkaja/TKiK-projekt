state 21

    (10) condition -> ID OPERATOR value .

    AND             reduce using rule 10 (condition -> ID OPERATOR value .)
    OR              reduce using rule 10 (condition -> ID OPERATOR value .)
    SEMICOLON       reduce using rule 10 (condition -> ID OPERATOR value .)


state 22

    (11) value -> STRING .

    AND             reduce using rule 11 (value -> STRING .)
    OR              reduce using rule 11 (value -> STRING .)
    SEMICOLON       reduce using rule 11 (value -> STRING .)


state 23

    (12) value -> NUMBER .

    AND             reduce using rule 12 (value -> NUMBER .)
    OR              reduce using rule 12 (value -> NUMBER .)
    SEMICOLON       reduce using rule 12 (value -> NUMBER .)

