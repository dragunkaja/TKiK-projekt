    NUMBER          shift and go to state 23

    value                          shift and go to state 21

state 19

    (8) condition -> condition AND condition .
    (8) condition -> condition . AND condition
    (9) condition -> condition . OR condition

    AND             reduce using rule 8 (condition -> condition AND condition .)
    OR              reduce using rule 8 (condition -> condition AND condition .)
    SEMICOLON       reduce using rule 8 (condition -> condition AND condition .)

  ! AND             [ shift and go to state 16 ]
  ! OR              [ shift and go to state 17 ]


state 20

    (9) condition -> condition OR condition .
    (8) condition -> condition . AND condition
