Rule 12    move_query -> MOVE FROM STRING TO STRING where_clause limit_clause
Rule 13    copy_query -> COPY FROM STRING TO STRING where_clause limit_clause
Rule 14    column_list -> STAR
Rule 15    column_list -> id_list
Rule 16    id_list -> ID
Rule 17    id_list -> ID COMMA id_list
